-- Additive only. Does not backfill or link any legacy AuthAccount rows.
-- Requires the existing auth_accounts and hospitals tables to be present.
CREATE TABLE hospital_memberships (
    membership_id UUID PRIMARY KEY,
    account_id BIGINT NOT NULL,
    hospital_uuid UUID NOT NULL,
    membership_role VARCHAR(32) NOT NULL,
    status VARCHAR(16) NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL,
    revoked_at TIMESTAMP WITH TIME ZONE NULL,
    revoked_by_account_id BIGINT NULL,
    CONSTRAINT uk_membership_account_single_hospital UNIQUE (account_id),
    CONSTRAINT fk_membership_account FOREIGN KEY (account_id) REFERENCES auth_accounts(id),
    CONSTRAINT fk_membership_hospital FOREIGN KEY (hospital_uuid) REFERENCES hospitals(hospital_uuid),
    CONSTRAINT fk_membership_revoked_by FOREIGN KEY (revoked_by_account_id) REFERENCES auth_accounts(id),
    CONSTRAINT ck_membership_role CHECK (membership_role IN (
        'HOSPITAL_SUPER_ADMIN', 'ADMIN', 'DOCTOR', 'NURSE', 'RECEPTIONIST',
        'PHARMACIST', 'LAB_TECHNICIAN', 'ACCOUNTS', 'STAFF')),
    CONSTRAINT ck_membership_status CHECK (status IN ('ACTIVE', 'INACTIVE', 'REVOKED'))
);

CREATE INDEX ix_membership_hospital_status ON hospital_memberships(hospital_uuid, status);

CREATE TABLE membership_audit_events (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    membership_id UUID NOT NULL,
    actor_account_id BIGINT NOT NULL,
    event_type VARCHAR(24) NOT NULL,
    occurred_at TIMESTAMP WITH TIME ZONE NOT NULL,
    CONSTRAINT fk_membership_audit_membership FOREIGN KEY (membership_id)
        REFERENCES hospital_memberships(membership_id),
    CONSTRAINT fk_membership_audit_actor FOREIGN KEY (actor_account_id) REFERENCES auth_accounts(id)
);

CREATE INDEX ix_membership_audit_membership_time
    ON membership_audit_events(membership_id, occurred_at);
