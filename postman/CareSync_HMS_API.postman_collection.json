    {
      "name": "2. Dashboard Statistics & Analytics (Real DB)",
      "item": [
        {
          "name": "Get All Dashboard Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Dashboard stats has all required non-negative metrics', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('todayOpdPatients');",
                  "    pm.expect(json.todayOpdPatients).to.be.at.least(0);",
                  "    pm.expect(json).to.have.property('todayRevenuePaise');",
                  "    pm.expect(json.todayRevenuePaise).to.be.at.least(0);",
                  "    pm.expect(json).to.have.property('totalBeds');",
                  "    pm.expect(json.totalBeds).to.be.at.least(0);",
                  "    pm.expect(json).to.have.property('occupiedBeds');",
                  "    pm.expect(json.occupiedBeds).to.be.at.least(0);",
                  "    pm.expect(json).to.have.property('bedOccupancyPercentage');",
                  "    pm.expect(json.bedOccupancyPercentage).to.be.at.least(0);",
                  "    pm.expect(json).to.have.property('pendingLabTests');",
                  "    pm.expect(json.pendingLabTests).to.be.at.least(0);",
                  "});",
                  "pm.test('Occupancy percentage formula matches (occupied/total * 100)', function () {",
                  "    var json = pm.response.json();",
                  "    if (json.totalBeds > 0) {",
                  "        var expected = (json.occupiedBeds / json.totalBeds) * 100;",
                  "        pm.expect(Math.abs(json.bedOccupancyPercentage - expected)).to.be.below(0.1);",
                  "    } else {",
                  "        pm.expect(json.bedOccupancyPercentage).to.equal(0);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reports/dashboard/stats?date={{today_date}}",
              "host": ["{{base_url}}"],
              "path": ["api", "reports", "dashboard", "stats"],
              "query": [
                { "key": "date", "value": "{{today_date}}" }
              ]
            }
          }
        },
